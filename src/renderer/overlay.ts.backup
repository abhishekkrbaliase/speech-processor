logger.info('🚀 OVERLAY.TS SCRIPT STARTING TO LOAD!');
logger.info('📍 Timestamp:', new Date().toISOString());
logger.info('🌐 Window object available:', typeof window !== 'undefined');
logger.info('📄 Document ready state:', document.readyState);

import { PatientRecord, Question, ProcessedResponse, ResponseType, LiveTranscriptionResult, UncertainWord, ConfidenceAnalysis } from '../shared/types';
import { logger } from '../shared/logger';
import { logger } from '../shared/logger';

logger.info('✅ OVERLAY.TS IMPORTS LOADED!');
logger.info('📍 Timestamp:', new Date().toISOString());

interface OverlayState {
  currentPatient: PatientRecord | null;
  currentQuestion: Question | null;
  currentResponse: ProcessedResponse | null;
  isListening: boolean;
  isProcessing: boolean;
  isPaused: boolean;
  questionIndex: number;
  patientIndex: number;
  totalQuestions: number;
  totalPatients: number;
  // Live transcription state
  currentTranscription: string;
  partialTranscription: string;
  isLiveTranscriptionActive: boolean;
  transcriptionConfidence: number;
  uncertainWords: UncertainWord[];
  isFinalizingResponse: boolean;
}

class OverlayRenderer {
  private state: OverlayState = {
    currentPatient: null,
    currentQuestion: null,
    currentResponse: null,
    isListening: false,
    isProcessing: false,
    isPaused: false,
    questionIndex: 0,
    patientIndex: 0,
    totalQuestions: 0,
    totalPatients: 0,
    // Live transcription state
    currentTranscription: '',
    partialTranscription: '',
    isLiveTranscriptionActive: false,
    transcriptionConfidence: 0,
    uncertainWords: [],
    isFinalizingResponse: false
  };

  private liveDisplayManager: LiveDisplayManager | null = null;

  private elements!: {
    patientMrn: HTMLElement;
    patientName: HTMLElement;
    progressText: HTMLElement;
    questionText: HTMLElement;
    statusIndicator: HTMLElement;
    statusText: HTMLElement;
    responseDisplay: HTMLElement;
    resetBtn: HTMLButtonElement;
    nextBtn: HTMLButtonElement;
    pauseBtn: HTMLButtonElement;
    testBtn: HTMLButtonElement;
    // Live transcription elements
    transcriptionStatus: HTMLElement;
    confidenceFill: HTMLElement;
    confidencePercentage: HTMLElement;
    wordCount: HTMLElement;
  };

logger.info('🎯 OVERLAYRENDERER CONSTRUCTOR CALLED!');
logger.info('📍 Timestamp:', new Date().toISOString());
logger.info('🌐 Window APIs available:', {
  electronAPI: !!window.electronAPI,
  dataManager: !!window.dataManager,
  questionnaire: !!(window as any).questionnaire
});
    
    try {
      console.log('🔧 Step 1: Initializing elements...');
      this.initializeElements();
      console.log('✅ Elements initialized');
      
      console.log('🔧 Step 2: Setting up event listeners...');
      this.setupEventListeners();
      console.log('✅ Event listeners set up');
      
      console.log('🔧 Step 3: Initializing live display manager...');
      this.initializeLiveDisplayManager();
      console.log('✅ Live display manager initialized');
      
      console.log('🔧 Step 4: Initializing overlay...');
      this.initializeOverlay();
      console.log('✅ Overlay initialization started');
      
      console.log('🎉 OVERLAYRENDERER CONSTRUCTOR COMPLETED!');
    } catch (error) {
      console.error('❌ ERROR IN OVERLAYRENDERER CONSTRUCTOR:', error);
      throw error;
    }
  }

  private initializeElements(): void {
    console.log('🔍 INITIALIZING DOM ELEMENTS...');
    console.log('📍 Timestamp:', new Date().toISOString());
    
    // Check if all required elements exist before assignment
    const elementIds = [
      'patient-mrn', 'patient-name', 'progress-text', 'question-text',
      'status-indicator', 'status-text', 'response-display',
      'reset-btn', 'next-btn', 'pause-btn', 'test-btn',
      'transcription-status', 'confidence-fill', 'confidence-percentage', 'word-count'
    ];
    
    console.log('🔍 Checking for required DOM elements...');
    const missingElements: string[] = [];
    elementIds.forEach(id => {
      const element = document.getElementById(id);
      if (!element) {
        missingElements.push(id);
        console.log(`❌ Missing element: ${id}`);
      } else {
        console.log(`✅ Found element: ${id}`);
      }
    });
    
    if (missingElements.length > 0) {
      console.error('❌ MISSING DOM ELEMENTS:', missingElements);
      console.log('📄 Available elements in document:');
      const allElements = document.querySelectorAll('[id]');
      allElements.forEach(el => console.log(`  - ${el.id}`));
    }
    
    this.elements = {
      patientMrn: document.getElementById('patient-mrn')!,
      patientName: document.getElementById('patient-name')!,
      progressText: document.getElementById('progress-text')!,
      questionText: document.getElementById('question-text')!,
      statusIndicator: document.getElementById('status-indicator')!,
      statusText: document.getElementById('status-text')!,
      responseDisplay: document.getElementById('response-display')!,
      resetBtn: document.getElementById('reset-btn') as HTMLButtonElement,
      nextBtn: document.getElementById('next-btn') as HTMLButtonElement,
      pauseBtn: document.getElementById('pause-btn') as HTMLButtonElement,
      testBtn: document.getElementById('test-btn') as HTMLButtonElement,
      // Live transcription elements
      transcriptionStatus: document.getElementById('transcription-status')!,
      confidenceFill: document.getElementById('confidence-fill')!,
      confidencePercentage: document.getElementById('confidence-percentage')!,
      wordCount: document.getElementById('word-count')!
    };
    
    console.log('✅ DOM ELEMENTS INITIALIZED');
    console.log('🔍 Element validation:', {
      testBtn: !!this.elements.testBtn,
      testBtnType: this.elements.testBtn?.tagName,
      testBtnId: this.elements.testBtn?.id
    });
  }

  private initializeLiveDisplayManager(): void {
    // Initialize LiveDisplayManager with the required elements
    try {
      const statusElement = document.querySelector('.response-status') || this.elements.statusText;
      this.liveDisplayManager = new LiveDisplayManager(
        this.elements.responseDisplay,
        statusElement as HTMLElement,
        this.elements.transcriptionStatus,
        {
          animationDuration: 300,
          fadeInDelay: 50,
          maxDisplayLength: 500
        }
      );
      console.log('✅ LiveDisplayManager initialized successfully');
    } catch (error) {
      console.error('❌ Failed to initialize LiveDisplayManager:', error);
      this.liveDisplayManager = null;
    }
  }

  private setupEventListeners(): void {
    console.log('🔧 SETTING UP EVENT LISTENERS...');
    console.log('📍 Timestamp:', new Date().toISOString());
    
    // Validate buttons exist before adding listeners
    if (!this.elements.testBtn) {
      console.error('❌ TEST BUTTON NOT FOUND - Cannot set up event listener!');
      return;
    }
    
    console.log('✅ Test button found, setting up event listeners...');
    
    // Control button event listeners
    this.elements.resetBtn.addEventListener('click', () => {
      console.log('🔄 RESET BUTTON CLICKED!');
      console.log('📍 Timestamp:', new Date().toISOString());
      this.handleReset();
    });
    
    this.elements.nextBtn.addEventListener('click', () => {
      console.log('▶️ NEXT BUTTON CLICKED!');
      console.log('📍 Timestamp:', new Date().toISOString());
      this.handleNext();
    });
    
    this.elements.pauseBtn.addEventListener('click', () => {
      console.log('⏸️ PAUSE BUTTON CLICKED!');
      console.log('📍 Timestamp:', new Date().toISOString());
      this.handlePause();
    });
    
    this.elements.testBtn.addEventListener('click', () => {
      console.log('🧪 TEST BUTTON CLICKED - STARTING COMPREHENSIVE TEST!');
      console.log('📍 Timestamp:', new Date().toISOString());
      console.log('🔍 Current State:', {
        patient: this.state.currentPatient?.mrn || 'None',
        question: this.state.currentQuestion?.text || 'None',
        isListening: this.state.isListening,
        isLiveTranscriptionActive: this.state.isLiveTranscriptionActive,
        isPaused: this.state.isPaused
      });
      
      // Visual feedback
      this.elements.testBtn.style.background = 'rgba(255, 0, 0, 0.6)';
      setTimeout(() => {
        this.elements.testBtn.style.background = 'rgba(76, 175, 80, 0.4)';
      }, 200);
      
      console.log('🚀 Calling handleTest()...');
      this.handleTest();
    });
    
    console.log('✅ Button event listeners set up successfully');
    
    // Add double-click test for speech recognition
    this.elements.statusText.addEventListener('dblclick', () => this.testSpeechRecognition());

    // Setup live transcription event listeners
    this.setupLiveTranscriptionEventListeners();

    // Keyboard shortcuts
    document.addEventListener('keydown', (event) => {
      // Prevent shortcuts during active transcription to avoid interruption
      if (this.state.isLiveTranscriptionActive && this.state.isListening) {
        // Only allow pause/escape during active listening
        if (event.key === 'Escape') {
          this.handlePause();
        }
        return;
      }
      
      if (event.key === 'Escape') {
        this.handlePause();
      } else if (event.key === 'Enter') {
        this.handleNext();
      } else if (event.key === 'Backspace' || event.key === 'Delete') {
        this.handleReset();
      } else if (event.key === ' ' && !this.state.currentResponse) {
        // Spacebar to start/stop listening
        event.preventDefault();
        if (this.state.isLiveTranscriptionActive) {
          this.stopLiveTranscription();
        } else {
          this.startLiveTranscription();
        }
      } else if (event.key === 's' && event.ctrlKey) {
        // Ctrl+S to check status
        event.preventDefault();
        this.checkLiveTranscriptionStatus();
      }
    });

    // Window focus events
    window.addEventListener('focus', () => {
      if (!this.state.isPaused) {
        this.resumeListening();
      }
    });

    window.addEventListener('blur', () => {
      // Optionally pause when window loses focus
      // this.pauseListening();
    });
  }

  private async initializeOverlay(): Promise<void> {
    console.log('🎯 OVERLAY INITIALIZATION STARTED');
    console.log('📊 Initial overlay state:', this.state);
    this.updateUI();
    
    // Ensure live transcription event listeners are set up
    console.log('🔧 Setting up live transcription event listeners...');
    this.setupLiveTranscriptionEventListeners();
    
    // Request initial data from main process
    try {
      console.log('📥 Loading initial data from main process...');
      await this.loadInitialData();
      console.log('✅ OVERLAY INITIALIZATION COMPLETED');
    } catch (error) {
      console.error('❌ OVERLAY INITIALIZATION FAILED:', error);
      this.showError('Failed to load data. Please ensure patient and question files are loaded.');
    }
  }

  private async loadInitialData(): Promise<void> {
    try {
      // Check if APIs are available
      if (!window.dataManager) {
        throw new Error('DataManager API not available');
      }

      // Load patients and questions
      const [patients, questions] = await Promise.all([
        window.dataManager.getAllPatients(),
        window.dataManager.getAllQuestions()
      ]);

      console.log(`Loaded ${patients.length} patients and ${questions.length} questions`);

      if (patients.length === 0) {
        this.showError('No patients loaded. Please load patient CSV file first.', true);
        return;
      }

      if (questions.length === 0) {
        this.showError('No questions loaded. Please load questions CSV file first.', true);
        return;
      }

      // Initialize with first patient and question
      console.log('First patient:', patients[0]);
      console.log('First question:', questions[0]);
      
      this.displayPatient(patients[0], 0, patients.length);
      this.displayQuestion(questions[0], 0, questions.length);
      
      this.setStatus('ready', 'Ready to begin questionnaire');
      
      // Check live transcription status first
      await this.checkLiveTranscriptionStatus();
      
      // Automatically start listening for the first question
      console.log('🎤 Auto-starting Google Speech-to-Text live transcription for first question...');
      setTimeout(async () => {
        try {
          await this.startLiveTranscription();
        } catch (error) {
          console.error('Failed to auto-start live transcription:', error);
        }
      }, 1000); // Small delay to ensure UI is ready

    } catch (error) {
      console.error('Failed to load initial data:', error);
      throw error;
    }
  }

  /**
   * Updates the current patient information
   */
  public displayPatient(patient: PatientRecord, patientIndex: number, totalPatients: number): void {
    console.log('👤 PATIENT DISPLAYED:', {
      patient: patient,
      patientIndex: patientIndex,
      totalPatients: totalPatients,
      mrn: patient.mrn,
      name: patient.name
    });
    this.state.currentPatient = patient;
    this.state.patientIndex = patientIndex;
    this.state.totalPatients = totalPatients;
    this.updatePatientDisplay();
    console.log('👤 Patient display updated in UI');
  }

  /**
   * Updates the current question
   */
  public displayQuestion(question: Question, questionIndex: number, totalQuestions: number): void {
    console.log('❓ QUESTION DISPLAYED:', {
      question: question,
      questionIndex: questionIndex,
      totalQuestions: totalQuestions,
      questionId: question.id,
      questionText: question.text,
      expectedResponseType: question.expectedResponseType
    });
    this.state.currentQuestion = question;
    this.state.questionIndex = questionIndex;
    this.state.totalQuestions = totalQuestions;
    this.updateQuestionDisplay();
    this.updateProgressDisplay();
    console.log('❓ Question display updated in UI');
  }

  /**
   * Shows a captured response
   */
  public showResponse(response: ProcessedResponse): void {
    this.state.currentResponse = response;
    
    // Use LiveDisplayManager for final response display
    if (this.liveDisplayManager && this.state.isLiveTranscriptionActive) {
      this.liveDisplayManager.showFinalResponse(response);
    } else {
      // Clear live transcription state
      this.clearLiveTranscription();
      
      // Update display with final response
      this.updateResponseDisplay();
    }
    
    this.setStatus('completed', 'Response captured');
    
    // Show confidence indicator if available
    if (response.confidence < 0.8) {
      this.elements.statusText.textContent = `Response captured (${Math.round(response.confidence * 100)}% confidence)`;
    }
    
    // Enable progression controls
    this.enableResetOption();
    this.elements.nextBtn.disabled = false;
  }

  /**
   * Enables reset functionality
   */
  public enableResetOption(): void {
    this.elements.resetBtn.disabled = false;
    this.elements.resetBtn.style.opacity = '1';
  }

  /**
   * Updates progress indicators
   */
  public updateProgress(questionIndex: number, totalQuestions: number, patientIndex: number, totalPatients: number): void {
    this.state.questionIndex = questionIndex;
    this.state.totalQuestions = totalQuestions;
    this.state.patientIndex = patientIndex;
    this.state.totalPatients = totalPatients;
    this.updateProgressDisplay();
  }

  /**
   * Shows error message
   */
  public showError(message: string, isRecoverable: boolean = true): void {
    this.setStatus('error', message);
    
    // Use LiveDisplayManager for error display
    if (this.liveDisplayManager && this.state.isLiveTranscriptionActive) {
      this.liveDisplayManager.showError(message, isRecoverable);
    } else {
      // Fallback to legacy error display
      this.elements.responseDisplay.textContent = `Error: ${message}`;
      this.elements.responseDisplay.className = 'response-display error';
    }
    
    // Disable controls during error state
    this.elements.nextBtn.disabled = true;
    
    // Auto-recovery for recoverable errors
    if (isRecoverable) {
      setTimeout(() => {
        this.setStatus('ready', 'Ready');
        this.elements.nextBtn.disabled = false;
      }, 3000);
    }
  }

  /**
   * Sets listening state
   */
  public async setListening(isListening: boolean): Promise<void> {
    this.state.isListening = isListening;
    
    if (isListening) {
      await this.startLiveTranscription();
    } else {
      await this.stopLiveTranscription();
    }
  }

  /**
   * Sets processing state
   */
  public setProcessing(isProcessing: boolean): void {
    this.state.isProcessing = isProcessing;
    if (isProcessing) {
      this.setStatus('processing', 'Processing speech...');
    }
  }

  /**
   * Sets paused state
   */
  public setPaused(isPaused: boolean): void {
    this.state.isPaused = isPaused;
    this.elements.pauseBtn.textContent = isPaused ? 'Resume' : 'Pause';
    
    if (isPaused) {
      this.setStatus('paused', 'Paused');
      this.hideLiveTranscriptionStatus();
    } else {
      this.setStatus('ready', 'Ready');
    }
  }

  /**
   * Updates live transcription display with partial results
   */
  public updateLiveTranscription(result: LiveTranscriptionResult): void {
    console.log('📝 updateLiveTranscription called:', result);
    this.state.isLiveTranscriptionActive = true;
    this.state.transcriptionConfidence = result.confidence;
    
    if (result.isFinal) {
      this.state.currentTranscription = result.transcript;
      this.state.partialTranscription = '';
      this.setStatus('processing', 'Processing response...');
    } else {
      this.state.partialTranscription = result.transcript;
    }
    
    // Use LiveDisplayManager for updates
    if (this.liveDisplayManager) {
      try {
        this.liveDisplayManager.updateLiveTranscription(result);
      } catch (error) {
        console.error('❌ LiveDisplayManager error:', error);
        // Fallback to direct display
        this.updateLiveTranscriptionDisplay();
      }
    } else {
      // Fallback to direct display
      console.log('📝 Using fallback display for transcription');
      this.updateLiveTranscriptionDisplay();
      this.showLiveTranscriptionStatus();
    }
  }

  /**
   * Updates confidence analysis display
   */
  public updateConfidenceAnalysis(analysis: ConfidenceAnalysis): void {
    this.state.transcriptionConfidence = analysis.overallConfidence;
    this.state.uncertainWords = analysis.uncertainWords;
    
    // Use LiveDisplayManager for updates
    if (this.liveDisplayManager) {
      this.liveDisplayManager.updateConfidenceAnalysis(analysis);
    } else {
      // Fallback to legacy display
      this.updateConfidenceDisplay();
      this.updateLiveTranscriptionDisplay();
    }
  }

  /**
   * Shows response finalization state
   */
  public setFinalizingResponse(isFinalizingResponse: boolean): void {
    this.state.isFinalizingResponse = isFinalizingResponse;
    
    if (isFinalizingResponse) {
      this.setStatus('processing', 'Finalizing response...');
      
      // Use LiveDisplayManager for finalization
      if (this.liveDisplayManager) {
        this.liveDisplayManager.setFinalizingResponse(isFinalizingResponse);
      }
    }
  }

  /**
   * Clears live transcription display
   */
  public clearLiveTranscription(): void {
    this.state.isLiveTranscriptionActive = false;
    this.state.currentTranscription = '';
    this.state.partialTranscription = '';
    this.state.transcriptionConfidence = 0;
    this.state.uncertainWords = [];
    this.state.isFinalizingResponse = false;
    
    // Use LiveDisplayManager for clearing
    if (this.liveDisplayManager) {
      this.liveDisplayManager.stopLiveDisplay();
    } else {
      // Fallback to legacy display
      this.hideLiveTranscriptionStatus();
    }
    
    this.updateResponseDisplay();
  }

  /**
   * Shows streaming status indicators
   */
  public showStreamingStatus(status: 'listening' | 'processing' | 'finalizing'): void {
    switch (status) {
      case 'listening':
        this.setStatus('listening', 'Listening for speech...');
        
        // Start live display manager
        if (this.liveDisplayManager) {
          this.liveDisplayManager.startLiveDisplay();
        } else {
          this.showLiveTranscriptionStatus();
        }
        break;
      case 'processing':
        this.setStatus('processing', 'Processing speech...');
        break;
      case 'finalizing':
        this.setStatus('processing', 'Finalizing response...');
        break;
    }
  }

  private updateUI(): void {
    this.updatePatientDisplay();
    this.updateQuestionDisplay();
    this.updateResponseDisplay();
    this.updateProgressDisplay();
  }

  private updatePatientDisplay(): void {
    if (this.state.currentPatient) {
      this.elements.patientMrn.textContent = `MRN: ${this.state.currentPatient.mrn}`;
      this.elements.patientName.textContent = this.state.currentPatient.name;
    } else {
      this.elements.patientMrn.textContent = 'MRN: --';
      this.elements.patientName.textContent = 'No patient loaded';
    }
  }

  private updateQuestionDisplay(): void {
    console.log('updateQuestionDisplay called', this.state.currentQuestion);
    
    const questionElement = this.elements.questionText;
    if (!questionElement) {
      console.error('Question text element not found!');
      return;
    }
    
    if (this.state.currentQuestion && this.state.currentQuestion.text) {
      console.log('Setting question text to:', this.state.currentQuestion.text);
      // Clear any existing content and set the new text
      questionElement.innerHTML = '';
      questionElement.textContent = this.state.currentQuestion.text;
    } else {
      console.log('No current question, showing placeholder');
      questionElement.innerHTML = '<span class="question-placeholder">Load questions to begin...</span>';
    }
  }

  private updateResponseDisplay(): void {
    // If live transcription is active, use live display
    if (this.state.isLiveTranscriptionActive) {
      this.updateLiveTranscriptionDisplay();
      return;
    }
    
    // Otherwise, show final response or empty state
    if (this.state.currentResponse) {
      const displayValue = this.formatResponseValue(this.state.currentResponse);
      this.elements.responseDisplay.textContent = displayValue;
      this.elements.responseDisplay.className = 'response-display';
    } else {
      this.elements.responseDisplay.textContent = 'No response captured';
      this.elements.responseDisplay.className = 'response-display empty';
    }
  }

  private updateProgressDisplay(): void {
    const questionProgress = `${this.state.questionIndex + 1}/${this.state.totalQuestions}`;
    const patientProgress = `Patient ${this.state.patientIndex + 1}/${this.state.totalPatients}`;
    
    if (this.state.totalPatients > 1) {
      this.elements.progressText.textContent = `${questionProgress} • ${patientProgress}`;
    } else {
      this.elements.progressText.textContent = questionProgress;
    }
  }

  private setStatus(type: 'ready' | 'listening' | 'processing' | 'completed' | 'paused' | 'error', text: string): void {
    this.elements.statusText.textContent = text;
    this.elements.statusIndicator.className = `status-indicator ${type}`;
  }

  private formatResponseValue(response: ProcessedResponse): string {
    switch (response.responseType) {
      case ResponseType.YES:
        return 'Yes';
      case ResponseType.NO:
        return 'No';
      case ResponseType.NOT_APPLICABLE:
        return 'Not Applicable';
      case ResponseType.DATE_TIME:
        if (response.parsedValue instanceof Date) {
          return response.parsedValue.toLocaleDateString() + ' ' + response.parsedValue.toLocaleTimeString();
        }
        return response.parsedValue?.toString() || response.rawText;
      case ResponseType.UNCLEAR:
        return `Unclear: "${response.rawText}"`;
      default:
        return response.rawText;
    }
  }

  private handleReset(): void {
    this.state.currentResponse = null;
    this.clearLiveTranscription();
    this.updateResponseDisplay();
    this.setStatus('ready', 'Ready');
    
    // Notify main process to reset current response
    // This will be implemented when IPC handlers are ready
    console.log('Reset requested');
  }

  private async handleNext(): Promise<void> {
    if (this.state.currentResponse) {
      // Save current response and proceed to next question
      await this.saveCurrentResponse();
      await this.proceedToNext();
    } else {
      // Start listening if no response captured
      await this.startLiveTranscription();
      console.log('Starting live transcription');
    }
  }

  private async saveCurrentResponse(): Promise<void> {
    if (!this.state.currentResponse || !this.state.currentPatient || !this.state.currentQuestion) {
      return;
    }

    try {
      // Save response using DataManager
      await window.dataManager.addResponse(this.state.currentResponse);
      console.log('Response saved successfully');
    } catch (error) {
      console.error('Failed to save response:', error);
      this.showError('Failed to save response', true);
    }
  }

  private async proceedToNext(): Promise<void> {
    try {
      const [patients, questions] = await Promise.all([
        window.dataManager.getAllPatients(),
        window.dataManager.getAllQuestions()
      ]);

      // Move to next question
      let nextQuestionIndex = this.state.questionIndex + 1;
      let nextPatientIndex = this.state.patientIndex;

      // If we've completed all questions for current patient, move to next patient
      if (nextQuestionIndex >= questions.length) {
        nextQuestionIndex = 0;
        nextPatientIndex++;

        // If we've completed all patients, show completion message
        if (nextPatientIndex >= patients.length) {
          this.showCompletionMessage();
          return;
        }
      }

      // Update display with next patient/question
      this.displayPatient(patients[nextPatientIndex], nextPatientIndex, patients.length);
      this.displayQuestion(questions[nextQuestionIndex], nextQuestionIndex, questions.length);

      // Clear current response and reset for next question
      this.state.currentResponse = null;
      this.clearLiveTranscription();
      this.updateResponseDisplay();
      this.setStatus('ready', 'Ready');

      // Disable next button until new response is captured
      this.elements.nextBtn.disabled = true;
      
      // Automatically start listening for the next question
      console.log('🎤 Auto-starting speech recognition for next question...');
      setTimeout(async () => {
        try {
          await this.startLiveTranscription();
        } catch (error) {
          console.error('Failed to auto-start speech recognition for next question:', error);
        }
      }, 500); // Small delay to ensure UI transition is complete

    } catch (error) {
      console.error('Failed to proceed to next:', error);
      this.showError('Failed to load next question', true);
    }
  }

  private showCompletionMessage(): void {
    this.setStatus('completed', 'All questionnaires completed!');
    this.elements.questionText.textContent = 'All questionnaires have been completed. You can now export the responses.';
    this.elements.responseDisplay.textContent = 'Questionnaire session complete';
    this.elements.nextBtn.disabled = false;
    this.elements.nextBtn.textContent = 'Export Responses';
    
    // Add export functionality to the next button
    this.elements.nextBtn.onclick = () => this.handleExport();
  }

  private async handleExport(): Promise<void> {
    try {
      this.setStatus('processing', 'Exporting responses...');
      this.elements.responseDisplay.textContent = 'Preparing export...';
      
      // Check if export API is available
      if (!window.exportManager) {
        throw new Error('Export functionality not available');
      }
      
      // Export settings
      const exportSettings = {
        format: 'csv' as const,
        includeTimestamps: true,
        includeConfidence: true,
        includeRawText: true,
        includePatientDetails: true,
        includeQuestionDetails: true,
        sortBy: 'timestamp' as const
      };
      
      const result = await window.exportManager.exportWithDialog(exportSettings);
      
      if (result.success) {
        this.setStatus('completed', `Export completed successfully!`);
        this.elements.responseDisplay.textContent = `Export completed: ${result.recordCount} responses saved`;
        
        // Option to close overlay after export
        setTimeout(() => {
          if (confirm('Export completed! Close the overlay?')) {
            window.close();
          }
        }, 2000);
      } else {
        this.setStatus('error', 'Export failed');
        this.elements.responseDisplay.textContent = `Export failed: ${result.error}`;
      }
    } catch (error) {
      console.error('Export error:', error);
      this.setStatus('error', 'Export failed');
      this.elements.responseDisplay.textContent = `Export error: ${error instanceof Error ? error.message : 'Unknown error'}`;
    }
  }

  private async handlePause(): Promise<void> {
    const newPausedState = !this.state.isPaused;
    this.setPaused(newPausedState);
    
    // Handle live transcription pause/resume
    if (newPausedState) {
      // Pause live transcription
      await this.stopLiveTranscription();
      this.clearLiveTranscription();
    } else if (!this.state.currentResponse) {
      // Resume live transcription if no response captured
      await this.startLiveTranscription();
    }
    
    // Notify main process about pause state change
    console.log(`${newPausedState ? 'Paused' : 'Resumed'} questionnaire`);
  }

  private async handleTest(): Promise<void> {
    console.log('🧪 HANDLETEST METHOD CALLED!');
    console.log('📍 Timestamp:', new Date().toISOString());
    console.log('🔍 DETAILED CURRENT STATE:', {
      isLiveTranscriptionActive: this.state.isLiveTranscriptionActive,
      isListening: this.state.isListening,
      isPaused: this.state.isPaused,
      currentResponse: this.state.currentResponse,
      currentPatient: this.state.currentPatient?.mrn || 'None',
      currentQuestion: this.state.currentQuestion?.text || 'None',
      hasElectronAPI: !!window.electronAPI,
      hasDataManager: !!window.dataManager
    });
    
    try {
      console.log('🎯 STARTING TEST SEQUENCE...');
      
      // Test 1: Check if we can start live transcription
      console.log('🧪 TEST 1: Attempting to start live transcription...');
      if (!this.state.isLiveTranscriptionActive) {
        console.log('🚀 Starting live transcription for test...');
        await this.startLiveTranscription();
        console.log('✅ Live transcription started for test');
      } else {
        console.log('ℹ️ Live transcription already active');
      }
      
      // Test 2: Simulate audio capture
      console.log('🧪 TEST 2: Simulating audio capture...');
      if (window.electronAPI) {
        console.log('🎤 Testing audio capture initialization...');
        const audioResult = await window.electronAPI.startAudioCapture({
          sampleRate: 16000,
          channels: 1,
          bufferSize: 4096
        });
        console.log('📊 Audio capture test result:', audioResult);
        
        // Test 3: Send dummy audio data
        console.log('🧪 TEST 3: Sending dummy audio data to Google Speech...');
        const dummyAudioBuffer = new ArrayBuffer(1024);
        const sendResult = await window.electronAPI.sendAudioToLiveTranscription(dummyAudioBuffer);
        console.log('📤 Dummy audio send result:', sendResult);
      } else {
        console.log('❌ ElectronAPI not available for audio tests');
      }
      
      // Test 4: Simple UI update (this should always work)
      console.log('🧪 TEST 4: Direct UI update test...');
      const testResults = [
        { transcript: 'yes', confidence: 0.95 },
        { transcript: 'no', confidence: 0.92 },
        { transcript: 'December fourth nineteen ninety one', confidence: 0.88 },
        { transcript: 'not applicable', confidence: 0.85 }
      ];
      
      const randomResult = testResults[Math.floor(Math.random() * testResults.length)];
      console.log('🎯 Selected test result:', randomResult);
      
      console.log('🖥️ Updating response display directly...');
      this.elements.responseDisplay.textContent = `TEST: ${randomResult.transcript}`;
      this.elements.responseDisplay.className = 'response-display';
      this.setStatus('completed', 'Test response captured');
      console.log('✅ Direct UI update completed');
      
      // Test 5: Create a mock processed response and show it
      setTimeout(() => {
        console.log('🧪 TEST 5: Creating mock processed response...');
        const mockResponse = {
          questionId: 'test',
          patientMrn: 'TEST001',
          rawText: randomResult.transcript,
          parsedValue: randomResult.transcript.toLowerCase() === 'yes' ? true : 
                      randomResult.transcript.toLowerCase() === 'no' ? false : randomResult.transcript,
          responseType: randomResult.transcript.toLowerCase() === 'yes' ? ResponseType.YES : 
                       randomResult.transcript.toLowerCase() === 'no' ? ResponseType.NO : ResponseType.UNCLEAR,
          confidence: randomResult.confidence,
          timestamp: new Date()
        };
        
        console.log('📝 Mock response created:', mockResponse);
        console.log('🖥️ Calling showResponse...');
        this.showResponse(mockResponse);
        console.log('✅ Mock response display completed');
      }, 1500);
      
      console.log('🎉 TEST SEQUENCE COMPLETED SUCCESSFULLY!');
      
    } catch (error) {
      console.error('❌ ERROR IN TEST SEQUENCE:', error);
      this.setStatus('error', `Test failed: ${error instanceof Error ? error.message : 'Unknown error'}`);
    }
  }

  private async resumeListening(): Promise<void> {
    if (!this.state.isPaused && !this.state.currentResponse) {
      await this.startLiveTranscription();
    }
  }

  private async pauseListening(): Promise<void> {
    await this.stopLiveTranscription();
  }

  private updateLiveTranscriptionDisplay(): void {
    console.log('🖥️ updateLiveTranscriptionDisplay called', {
      isActive: this.state.isLiveTranscriptionActive,
      currentTranscription: this.state.currentTranscription,
      partialTranscription: this.state.partialTranscription
    });
    
    if (!this.state.isLiveTranscriptionActive) {
      console.log('❌ Live transcription not active, skipping display update');
      return;
    }

    const displayElement = this.elements.responseDisplay;
    displayElement.className = 'response-display live';
    
    let displayContent = '';
    
    // Show final transcription
    if (this.state.currentTranscription) {
      displayContent += this.formatTranscriptionWithConfidence(this.state.currentTranscription, true);
    }
    
    // Show partial transcription
    if (this.state.partialTranscription) {
      if (displayContent) displayContent += ' ';
      displayContent += `<span class="partial-text">${this.escapeHtml(this.state.partialTranscription)}</span>`;
      
      // Add typing indicator
      if (!this.state.isFinalizingResponse) {
        displayContent += '<span class="typing-indicator">...</span>';
      }
    }
    
    if (!displayContent) {
      displayContent = '<span class="partial-text">Listening...</span>';
    }
    
    displayElement.innerHTML = displayContent;
    
    // Auto-scroll to bottom
    displayElement.scrollTop = displayElement.scrollHeight;
  }

  private formatTranscriptionWithConfidence(text: string, isFinal: boolean): string {
    if (!this.state.uncertainWords.length) {
      const className = isFinal ? 'final-text' : 'partial-text';
      return `<span class="${className}">${this.escapeHtml(text)}</span>`;
    }

    let formattedText = text;
    const words = text.split(/\s+/);
    let result = '';
    
    words.forEach((word, index) => {
      const uncertainWord = this.state.uncertainWords.find(uw => 
        uw.position === index || uw.word.toLowerCase() === word.toLowerCase()
      );
      
      if (uncertainWord) {
        const riskClass = uncertainWord.severity === 'high' ? 'high-risk' : '';
        const confidenceClass = this.getConfidenceClass(uncertainWord.confidence);
        result += `<span class="uncertain-word ${riskClass}" title="Confidence: ${Math.round(uncertainWord.confidence * 100)}% - ${uncertainWord.reason}">${this.escapeHtml(word)}<span class="confidence-indicator ${confidenceClass}"></span></span>`;
      } else {
        result += this.escapeHtml(word);
      }
      
      if (index < words.length - 1) {
        result += ' ';
      }
    });
    
    const className = isFinal ? 'final-text' : 'partial-text';
    return `<span class="${className}">${result}</span>`;
  }

  private updateConfidenceDisplay(): void {
    const confidence = Math.round(this.state.transcriptionConfidence * 100);
    this.elements.confidencePercentage.textContent = `${confidence}%`;
    this.elements.confidenceFill.style.width = `${confidence}%`;
    
    // Update word count
    const totalWords = (this.state.currentTranscription + ' ' + this.state.partialTranscription).trim().split(/\s+/).filter(w => w.length > 0).length;
    this.elements.wordCount.textContent = `${totalWords} word${totalWords !== 1 ? 's' : ''}`;
  }

  private showLiveTranscriptionStatus(): void {
    this.elements.transcriptionStatus.style.display = 'flex';
    this.updateConfidenceDisplay();
  }

  private hideLiveTranscriptionStatus(): void {
    this.elements.transcriptionStatus.style.display = 'none';
  }

  private getConfidenceClass(confidence: number): string {
    if (confidence >= 0.8) return 'confidence-high';
    if (confidence >= 0.6) return 'confidence-medium';
    return 'confidence-low';
  }

  private escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  /**
   * Setup audio event listeners for speech recognition
   */
  private setupLiveTranscriptionEventListeners(): void {
    if (!window.electronAPI) return;

    console.log('🔧 RENDERER: Setting up live transcription event listeners');

    // Listen for partial results from Google Speech-to-Text
    window.electronAPI.onPartialResult((result: any) => {
      console.log('🎵 RENDERER RECEIVED PARTIAL RESULT:', {
        transcript: result.transcript,
        confidence: result.confidence,
        stability: result.stability,
        hasTranscript: !!(result.transcript && result.transcript.trim()),
        timestamp: new Date().toISOString()
      });
      
      if (result.transcript && result.transcript.trim()) {
        const liveResult = {
          transcript: result.transcript,
          confidence: result.confidence || 0,
          isFinal: false,
          timestamp: new Date()
        };
        
        console.log('📝 RENDERER: Processing partial result');
        this.updateLiveTranscription(liveResult);
      } else {
        console.log('⚠️ RENDERER: Partial result has no transcript, ignoring');
      }
    });

    // Listen for final results from Google Speech-to-Text
    window.electronAPI.onFinalResult((result: any) => {
      console.log('✅ RENDERER RECEIVED FINAL RESULT:', {
        transcript: result.transcript,
        confidence: result.confidence,
        words: result.words?.length || 0,
        hasTranscript: !!(result.transcript && result.transcript.trim()),
        timestamp: new Date().toISOString()
      });
      
      if (result.transcript && result.transcript.trim()) {
        const liveResult = {
          transcript: result.transcript,
          confidence: result.confidence || 0,
          isFinal: true,
          timestamp: new Date()
        };
        
        console.log('📝 RENDERER: Processing final result');
        this.updateLiveTranscription(liveResult);
        
        // Process the final result as a response
        console.log('🔄 RENDERER: Processing final transcription result');
        this.processFinalTranscriptionResult(result);
      } else {
        console.log('⚠️ RENDERER: Final result has no transcript, ignoring');
      }
    });

    // Listen for live transcription errors
    window.electronAPI.onLiveTranscriptionError((error: any) => {
      console.error('❌ RENDERER RECEIVED TRANSCRIPTION ERROR:', {
        code: error.code,
        message: error.message,
        recoverable: error.recoverable,
        timestamp: new Date().toISOString()
      });
      
      this.showError(`Speech recognition error: ${error.message || 'Unknown error'}`, true);
      
      // Try to restart transcription after a brief delay
      setTimeout(async () => {
        if (this.state.isLiveTranscriptionActive) {
          console.log('🔄 RENDERER: Attempting to restart live transcription...');
          await this.restartLiveTranscription();
        }
      }, 2000);
    });
    
    console.log('✅ RENDERER: Live transcription event listeners set up successfully');
  }

  private setupAudioEventListeners(): void {
    if (!window.electronAPI) return;

    // Listen for audio detection events
    window.electronAPI.onAudioDetected((audioBuffer: ArrayBuffer) => {
      console.log('🎵 RENDERER AUDIO DETECTED:', {
        audioBufferSize: audioBuffer.byteLength,
        isLiveTranscriptionActive: this.state.isLiveTranscriptionActive,
        timestamp: new Date().toISOString()
      });
      
      // Send audio to live transcription service
      if (this.state.isLiveTranscriptionActive) {
        console.log('📤 RENDERER: Sending audio to live transcription service');
        this.sendAudioToLiveTranscription(audioBuffer);
      } else {
        console.warn('⚠️ RENDERER: Live transcription not active, ignoring audio');
      }
    });

    // Listen for audio errors
    window.electronAPI.onAudioError((error: string) => {
      console.error('🎤 Audio error:', error);
      this.showError(`Audio error: ${error}`, true);
    });

    // Listen for voice activity detection
    window.electronAPI.onVoiceActivity((vadResult: any) => {
      console.log('🗣️ Voice activity detected:', vadResult.isSpeaking ? 'Speaking' : 'Silent');
      
      if (vadResult.isSpeaking) {
        this.setStatus('listening', 'Speech detected...');
      } else {
        this.setStatus('listening', 'Listening...');
      }
    });

    // Listen for speech segments
    window.electronAPI.onSpeechSegment((segment: any) => {
      console.log('📝 Speech segment received, size:', segment.audioBuffer?.byteLength || 0, 'bytes');
      
      if (segment.audioBuffer && this.state.isLiveTranscriptionActive) {
        this.sendAudioToLiveTranscription(segment.audioBuffer);
      }
    });
  }

  /**
   * Process audio input through AI service
   */
  private async processAudioInput(audioBuffer: ArrayBuffer): Promise<void> {
    if (!this.state.isLiveTranscriptionActive || !window.electronAPI) {
      return;
    }

    try {
      // Validate audio buffer
      if (!audioBuffer || audioBuffer.byteLength === 0) {
        console.log('⚠️ Empty audio buffer, skipping processing');
        return;
      }
      
      console.log('🎵 Processing audio buffer:', audioBuffer.byteLength, 'bytes');
      this.setStatus('processing', 'Processing speech...');
      
      // Process audio through AI service
      const result = await window.electronAPI.processAudio(audioBuffer);
      
      if (result.success && result.response) {
        console.log('✅ Speech processed:', result.response);
        
        // Only show response if it's meaningful (not empty or unclear)
        if (result.response.rawText && result.response.rawText.trim().length > 0) {
          // Show the processed response
          this.showResponse(result.response);
          
          // Stop live transcription since we have a response
          await this.stopLiveTranscription();
        } else {
          console.log('ℹ️ Empty or unclear response, continuing to listen...');
          this.setStatus('listening', 'Listening...');
        }
      } else {
        console.warn('⚠️ No response from speech processing:', result.error);
        this.setStatus('listening', 'Listening...');
      }
    } catch (error) {
      console.error('❌ Error processing audio:', error);
      // Don't show error for every processing attempt, just log it
      this.setStatus('listening', 'Listening...');
    }
  }

  /**
   * Start live transcription using Google Speech-to-Text streaming
   */
  public async startLiveTranscription(): Promise<void> {
    if (this.state.isPaused) return;
    
    this.state.isLiveTranscriptionActive = true;
    this.showStreamingStatus('listening');
    
    // Enable reset button during transcription
    this.elements.resetBtn.disabled = false;
    
    // Disable next button until response is captured
    this.elements.nextBtn.disabled = true;
    
    // Update button text to show current action
    this.elements.nextBtn.textContent = 'Listening...';
    
    try {
      console.log('🎤 Initializing Google Speech-to-Text live transcription...');
      
      if (!window.electronAPI) {
        throw new Error('ElectronAPI not available');
      }
      
      // Initialize AI service for response processing
      console.log('🤖 Initializing AI service for response processing...');
      const aiInitResult = await window.electronAPI.initializeAI();
      if (!aiInitResult.success) {
        console.warn('⚠️ AI service initialization failed, will use text-only processing:', aiInitResult.error);
      } else {
        console.log('✅ AI service initialized for response processing');
      }
      
      // Initialize live transcription service
      console.log('🔧 Initializing live transcription service...');
      const initResult = await window.electronAPI.initializeLiveTranscription();
      if (!initResult.success) {
        throw new Error(initResult.error || 'Failed to initialize live transcription service');
      }
      console.log('✅ Live transcription service initialized');
      
      // Start streaming recognition
      console.log('🎵 Starting live transcription streaming...');
      const streamResult = await window.electronAPI.startLiveTranscriptionStreaming();
      if (!streamResult.success) {
        throw new Error(streamResult.error || 'Failed to start live transcription streaming');
      }
      console.log('✅ Live transcription streaming started');
      
      // Set up audio event listeners for capturing and sending audio
      this.setupAudioEventListeners();
      
      // Start audio capture
      console.log('🎤 Starting audio capture...');
      const audioResult = await window.electronAPI.startAudioCapture({
        sampleRate: 16000,
        channels: 1,
        bufferSize: 4096
      });
      
      if (!audioResult.success) {
        console.warn('⚠️ Native audio capture failed, trying browser fallback:', audioResult.error);
        // Try fallback: use browser-based audio capture
        await this.startBrowserAudioCapture();
      } else {
        console.log('✅ Native audio capture started successfully');
      }
      
      // Start a periodic check for audio buffer (fallback method)
      this.startAudioPolling();
      
      console.log('✅ Google Speech-to-Text live transcription started successfully');
      
      // Update status to show we're actively listening
      this.setStatus('listening', 'Listening for speech... (Google Speech-to-Text active)');
      
    } catch (error) {
      console.error('❌ Failed to start Google Speech-to-Text live transcription:', error);
      this.showError(`Failed to start speech recognition: ${error instanceof Error ? error.message : 'Unknown error'}`, true);
      this.state.isLiveTranscriptionActive = false;
      this.elements.nextBtn.textContent = 'Next';
      this.elements.nextBtn.disabled = false;
    }
  }

  /**
   * Send audio data to live transcription service
   */
  private async sendAudioToLiveTranscription(audioBuffer: ArrayBuffer): Promise<void> {
    console.log('📤 RENDERER sendAudioToLiveTranscription called:', {
      audioBufferSize: audioBuffer.byteLength,
      isLiveTranscriptionActive: this.state.isLiveTranscriptionActive,
      hasElectronAPI: !!window.electronAPI,
      timestamp: new Date().toISOString()
    });
    
    if (!this.state.isLiveTranscriptionActive || !window.electronAPI) {
      console.log('🚫 RENDERER: Live transcription not active or API not available:', {
        isLiveTranscriptionActive: this.state.isLiveTranscriptionActive,
        hasElectronAPI: !!window.electronAPI
      });
      return;
    }

    if (!audioBuffer || audioBuffer.byteLength === 0) {
      console.log('🚫 RENDERER: Empty audio buffer, skipping');
      return;
    }

    try {
      // Send audio chunk to Google Speech-to-Text streaming
      console.log('📤 RENDERER: Calling electronAPI.sendAudioToLiveTranscription with:', {
        audioBufferSize: audioBuffer.byteLength,
        timestamp: new Date().toISOString()
      });
      
      const result = await window.electronAPI.sendAudioToLiveTranscription(audioBuffer);
      
      console.log('📨 RENDERER: Received response from sendAudioToLiveTranscription:', {
        success: result.success,
        error: result.error,
        timestamp: new Date().toISOString()
      });
      
      if (!result.success) {
        console.warn('⚠️ RENDERER: Failed to send audio to live transcription:', result.error);
        // Don't show error to user for individual chunk failures
      } else {
        console.log('✅ RENDERER: Audio chunk sent successfully to live transcription');
      }
    } catch (error) {
      console.error('❌ RENDERER: Error sending audio to live transcription:', {
        error: error instanceof Error ? error.message : 'Unknown error',
        stack: error instanceof Error ? error.stack : undefined,
        timestamp: new Date().toISOString()
      });
      
      // Only show error if it's a persistent issue
      if (this.state.isLiveTranscriptionActive) {
        this.showError('Audio processing error - trying to reconnect...', true);
      }
    }
  }

  /**
   * Process final transcription result and create a response
   */
  private async processFinalTranscriptionResult(result: any): Promise<void> {
    try {
      console.log('🔄 Processing final transcription result:', result.transcript);
      
      // Use the existing AI service to parse the transcription into a structured response
      const parseResult = await window.electronAPI.processAudio(new ArrayBuffer(0), result.transcript);
      
      if (parseResult.success && parseResult.response) {
        console.log('✅ Transcription processed into response:', parseResult.response);
        
        // Show the processed response
        this.showResponse(parseResult.response);
        
        // Stop live transcription since we have a response
        await this.stopLiveTranscription();
      } else {
        console.log('ℹ️ Transcription could not be processed into a clear response, continuing to listen...');
        // Continue listening for more speech
      }
    } catch (error) {
      console.error('❌ Error processing final transcription result:', error);
    }
  }

  /**
   * Restart live transcription after an error
   */
  private async restartLiveTranscription(): Promise<void> {
    try {
      console.log('🔄 Restarting live transcription...');
      
      // Stop current transcription
      await this.stopLiveTranscription();
      
      // Wait a moment before restarting
      await new Promise(resolve => setTimeout(resolve, 1000));
      
      // Start again
      await this.startLiveTranscription();
      
      console.log('✅ Live transcription restarted successfully');
    } catch (error) {
      console.error('❌ Failed to restart live transcription:', error);
      this.showError('Failed to restart speech recognition. Please try manually.', true);
    }
  }

  /**
   * Stop live transcription
   */
  public async stopLiveTranscription(): Promise<void> {
    this.clearLiveTranscription();
    this.setStatus('ready', 'Ready');
    
    // Reset button states
    this.elements.nextBtn.textContent = 'Next';
    this.elements.nextBtn.disabled = false;
    
    // Stop audio polling
    this.stopAudioPolling();
    
    // Stop browser audio capture if active
    this.stopBrowserAudioCapture();
    
    // Stop audio capture
    try {
      if (window.electronAPI) {
        await window.electronAPI.stopAudioCapture();
        console.log('🛑 Speech recognition stopped');
      }
    } catch (error) {
      console.error('❌ Error stopping speech recognition:', error);
    }
  }

  private audioPollingInterval: NodeJS.Timeout | null = null;
  private browserMediaStream: MediaStream | null = null;
  private browserAudioContext: AudioContext | null = null;
  private browserProcessor: ScriptProcessorNode | null = null;

  /**
   * Start periodic audio buffer polling as fallback
   */
  private startAudioPolling(): void {
    if (this.audioPollingInterval) return;
    
    console.log('🔄 RENDERER: Starting audio polling for live transcription...');
    this.audioPollingInterval = setInterval(async () => {
      if (!this.state.isLiveTranscriptionActive || !window.electronAPI) {
        return;
      }
      
      try {
        // Check if audio is being captured
        const isListening = await window.electronAPI.isAudioListening();
        console.log('🎤 RENDERER AUDIO POLLING:', {
          isListening: isListening,
          isLiveTranscriptionActive: this.state.isLiveTranscriptionActive,
          timestamp: new Date().toISOString()
        });
        
        if (isListening) {
          // Get audio buffer
          const bufferResult = await window.electronAPI.getAudioBuffer();
          console.log('📊 RENDERER AUDIO BUFFER RESULT:', {
            success: bufferResult.success,
            hasBuffer: !!bufferResult.buffer,
            bufferSize: bufferResult.buffer?.byteLength || 0,
            error: bufferResult.error
          });
          
          if (bufferResult.success && bufferResult.buffer) {
            console.log('📊 RENDERER: Got audio buffer from polling, sending to live transcription:', bufferResult.buffer.byteLength, 'bytes');
            // Send to live transcription service instead of old AI service
            await this.sendAudioToLiveTranscription(bufferResult.buffer);
          } else {
            console.log('⚠️ RENDERER: No audio buffer available');
          }
        } else {
          console.log('⚠️ RENDERER: Audio capture not active, checking microphone permissions...');
          this.setStatus('error', 'Microphone not active - check permissions');
        }
      } catch (error) {
        console.error('❌ RENDERER: Error in audio polling:', {
          error: error instanceof Error ? error.message : 'Unknown error',
          timestamp: new Date().toISOString()
        });
      }
    }, 500); // Poll every 500ms for better responsiveness
  }

  /**
   * Stop audio polling
   */
  private stopAudioPolling(): void {
    if (this.audioPollingInterval) {
      clearInterval(this.audioPollingInterval);
      this.audioPollingInterval = null;
      console.log('🛑 Audio polling stopped');
    }
  }

  /**
   * Start browser-based audio capture as fallback
   */
  private async startBrowserAudioCapture(): Promise<void> {
    try {
      console.log('🌐 Starting browser audio capture fallback...');
      
      // Request microphone access
      this.browserMediaStream = await navigator.mediaDevices.getUserMedia({
        audio: {
          sampleRate: 16000,
          channelCount: 1,
          echoCancellation: true,
          noiseSuppression: true,
          autoGainControl: true
        }
      });
      
      // Create audio context
      this.browserAudioContext = new (window.AudioContext || (window as any).webkitAudioContext)({
        sampleRate: 16000
      });
      
      const source = this.browserAudioContext.createMediaStreamSource(this.browserMediaStream);
      
      // Create script processor for audio processing
      this.browserProcessor = this.browserAudioContext.createScriptProcessor(4096, 1, 1);
      
      this.browserProcessor.onaudioprocess = async (event) => {
        if (!this.state.isLiveTranscriptionActive) return;
        
        const inputBuffer = event.inputBuffer;
        const inputData = inputBuffer.getChannelData(0);
        
        // Check for actual audio activity
        let hasAudio = false;
        let maxAmplitude = 0;
        for (let i = 0; i < inputData.length; i++) {
          const amplitude = Math.abs(inputData[i]);
          maxAmplitude = Math.max(maxAmplitude, amplitude);
          if (amplitude > 0.01) { // Threshold for detecting audio
            hasAudio = true;
          }
        }
        
        if (hasAudio) {
          console.log('🎵 Browser audio detected, max amplitude:', maxAmplitude.toFixed(4));
          
          // Convert Float32Array to ArrayBuffer
          const audioBuffer = inputData.buffer.slice(
            inputData.byteOffset,
            inputData.byteOffset + inputData.byteLength
          );
          
          // Process the audio
          await this.processAudioInput(audioBuffer);
        }
      };
      
      // Connect the nodes
      source.connect(this.browserProcessor);
      this.browserProcessor.connect(this.browserAudioContext.destination);
      
      console.log('✅ Browser audio capture started successfully');
      
    } catch (error) {
      console.error('❌ Failed to start browser audio capture:', error);
      throw new Error(`Browser audio capture failed: ${error instanceof Error ? error.message : 'Unknown error'}`);
    }
  }

  /**
   * Stop browser audio capture
   */
  private stopBrowserAudioCapture(): void {
    try {
      if (this.browserProcessor) {
        this.browserProcessor.disconnect();
        this.browserProcessor = null;
      }
      
      if (this.browserAudioContext) {
        this.browserAudioContext.close();
        this.browserAudioContext = null;
      }
      
      if (this.browserMediaStream) {
        this.browserMediaStream.getTracks().forEach(track => track.stop());
        this.browserMediaStream = null;
      }
      
      console.log('🛑 Browser audio capture stopped');
    } catch (error) {
      console.error('❌ Error stopping browser audio capture:', error);
    }
  }

  /**
   * Test speech recognition with sample text (double-click status to trigger)
   */
  private async testSpeechRecognition(): Promise<void> {
    console.log('🧪 Testing speech recognition...');
    
    try {
      if (!window.electronAPI) {
        throw new Error('ElectronAPI not available');
      }
      
      // Test with sample text
      const testTexts = ['yes', 'no', 'December fourth nineteen ninety one'];
      const randomText = testTexts[Math.floor(Math.random() * testTexts.length)];
      
      this.setStatus('processing', 'Testing speech recognition...');
      
      // Process with override text (bypasses audio processing)
      const result = await window.electronAPI.processAudio(new ArrayBuffer(0), randomText);
      
      if (result.success && result.response) {
        console.log('✅ Speech recognition test successful:', result.response);
        this.showResponse(result.response);
        
        // Show test indicator
        setTimeout(() => {
          this.elements.responseDisplay.innerHTML += ' <small style="color: #888;">(test)</small>';
        }, 100);
      } else {
        throw new Error(result.error || 'Test failed');
      }
    } catch (error) {
      console.error('❌ Speech recognition test failed:', error);
      this.showError(`Test failed: ${error instanceof Error ? error.message : 'Unknown error'}`, true);
    }
  }

  /**
   * Check live transcription status and log debugging information
   */
  private async checkLiveTranscriptionStatus(): Promise<void> {
    try {
      if (!window.electronAPI) {
        console.log('❌ ElectronAPI not available');
        return;
      }

      console.log('🔍 Checking live transcription status...');
      
      const statusResult = await window.electronAPI.getLiveTranscriptionStatus();
      if (statusResult.success) {
        console.log('📊 Live transcription status:', statusResult.status);
      } else {
        console.log('❌ Failed to get live transcription status:', statusResult.error);
      }

      const configResult = await window.electronAPI.getLiveTranscriptionConfig();
      if (configResult.success) {
        console.log('⚙️ Live transcription config:', configResult.config);
      } else {
        console.log('❌ Failed to get live transcription config:', configResult.error);
      }
    } catch (error) {
      console.error('❌ Error checking live transcription status:', error);
    }
  }
}

