{
  "name": "speech-overlay-app",
  "version": "1.0.0",
  "description": "Cross-platform desktop application for collecting speech-based responses to questionnaires using Electron and Gemma 3n AI models",
  "main": "dist/main.js",
  "homepage": "./",
  "scripts": {
    "build": "webpack --mode=production && npm run test:audio-integration",
    "build:dev": "webpack --mode=development",
    "build:no-validation": "webpack --mode=production",
    "start": "npm run build:dev && electron .",
    "dev": "concurrently \"webpack --mode=development --watch\" \"nodemon --watch dist --exec electron .\"",
    "dev:renderer": "webpack-dev-server --mode=development --config webpack.renderer.config.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac-universal": "npm run build && electron-builder --mac --universal",
    "dist:win-portable": "npm run build && electron-builder --win --config.win.target=portable",
    "build:release": "npm run clean && npm run build && npm run prepare-build-resources",
    "build:ci": "NODE_ENV=production npm run build",
    "build:dev-skip-validation": "SKIP_AUDIO_VALIDATION=true npm run build",
    "prepare-build-resources": "node scripts/prepare-build.js",
    "build:standalone": "node scripts/build-standalone.js",
    "build:standalone:mac": "node scripts/build-standalone.js mac",
    "build:standalone:win": "node scripts/build-standalone.js win",
    "package": "node scripts/package-app.js",
    "package:mac": "node scripts/package-app.js mac",
    "package:win": "node scripts/package-app.js win",
    "package:all": "node scripts/package-app.js all",
    "generate:icons": "node scripts/generate-icons.js",
    "setup:production": "node scripts/setup-production.js",
    "setup:development": "node scripts/setup-development.js",
    "package:summary": "node scripts/package-summary.js",
    "test:app": "node test-application.js",
    "test:integration": "npm run build && npm run test:app",
    "clean": "rm -rf dist build",
    "postinstall": "electron-builder install-app-deps",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:live-transcription": "npm run build && jest tests/live-transcription.test.js --verbose",
    "test:audio": "npm run test:live-transcription",
    "test:audio-file": "node test-audio-transcription.js",
    "test:audio-validation": "node test-audio-validation.js",
    "test:audio-integration": "node test-audio-integration.js",
    "demo": "npm run build:dev && node run-demo.js",
    "demo:build": "npm run build && node run-demo.js",
    "demo:transcription": "node src/demo/run-electron-test.js",
    "demo:csv-parser": "npx ts-node src/examples/csv-parser-demo.ts",
    "demo:questions-parser": "npx ts-node src/examples/questions-parser-demo.ts",
    "test:transcription": "node src/demo/run-transcription-test.js"
  },
  "build": {
    "appId": "com.speechprocessor.app",
    "productName": "Speech Processor",
    "afterPack": "./scripts/afterPack.js",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "google-credentials.json",
      "config.json"
    ],
    "asarUnpack": [
      "node_modules/@google-cloud/**/*"
    ],
    "extraResources": [
      {
        "from": "google-credentials.json",
        "to": "google-credentials.json"
      },
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "mac": {
      "category": "public.app-category.medical",
      "icon": "build-resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": null,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Speech Processor needs access to your microphone to transcribe speech for questionnaire responses."
      }
    },
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Speech Processor",
      "include": "build-resources/installer.nsh"
    },
    "dmg": {
      "title": "Speech Processor ${version}",
      "icon": "build-resources/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "publish": null,
    "extraMetadata": {
      "main": "dist/main.js"
    }
  },
  "keywords": [
    "electron",
    "speech-recognition",
    "questionnaire",
    "healthcare",
    "overlay",
    "ai",
    "gemma"
  ],
  "author": "Speech Overlay App Team",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.3",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.2",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "html-webpack-plugin": "^5.6.4",
    "jest": "^30.1.3",
    "node-loader": "^2.1.0",
    "nodemon": "^3.1.10",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "@google-cloud/speech": "^7.2.0",
    "node-record-lpcm16": "^1.0.1"
  }
}